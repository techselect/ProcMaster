<Window x:Class="ProcMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProcMaster"
        xmlns:models="clr-namespace:ProcMaster.Models"
        xmlns:vm="clr-namespace:ProcMaster.ViewModels"
        xmlns:conv="clr-namespace:ProcMaster.Converters"
        mc:Ignorable="d"
        Title="ProcMaster - Process Explorer &amp; Task Manager" Height="800" Width="1200"
        Background="#1E1E1E" Foreground="#CCCCCC"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:CpuColorConverter x:Key="CpuColorConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Dark Theme Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#DCDCDC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#333333"/>
            <Setter Property="RowBackground" Value="#252526"/>
            <Setter Property="AlternatingRowBackground" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#434346"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="#3E3E42" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" Margin="2,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="8,4"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Toolbar & Search -->
            <RowDefinition Height="3*"/>   <!-- Process List / Tree -->
            <RowDefinition Height="5"/>    <!-- Grid Splitter -->
            <RowDefinition Height="2*"/>   <!-- Lower Pane (Handles, DLLs, Threads) -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Action & Search Bar -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="8,6" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,15,0">
                    <Button Content="⚡ Kill Process" Click="OnKillProcess_Click" Margin="0,0,5,0" Padding="10,4" Background="#C62828" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                    <Button Content="🌳 Kill Process Tree" Click="OnKillTree_Click" Margin="0,0,5,0" Padding="10,4" Background="#8E0000" Foreground="White" BorderThickness="0"/>
                    <Button Content="⏸ Suspend" Click="OnSuspend_Click" Margin="0,0,5,0" Padding="8,4" Background="#455A64" Foreground="White" BorderThickness="0"/>
                    <Button Content="▶ Resume" Click="OnResume_Click" Margin="0,0,5,0" Padding="8,4" Background="#2E7D32" Foreground="White" BorderThickness="0"/>
                    
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="5,0">
                        <MenuItem Header="⚙ Set Priority" Background="#3E3E42" Foreground="White">
                            <MenuItem Header="Realtime" Click="OnPriorityRealtime_Click"/>
                            <MenuItem Header="High" Click="OnPriorityHigh_Click"/>
                            <MenuItem Header="Above Normal" Click="OnPriorityAboveNormal_Click"/>
                            <MenuItem Header="Normal" Click="OnPriorityNormal_Click"/>
                            <MenuItem Header="Below Normal" Click="OnPriorityBelowNormal_Click"/>
                            <MenuItem Header="Idle" Click="OnPriorityIdle_Click"/>
                        </MenuItem>
                    </Menu>

                    <Button Content="🔄 Refresh Now" Click="OnRefresh_Click" Margin="5,0,0,0" Padding="8,4" Background="#333337" Foreground="#DDD" BorderBrush="#555"/>
                </StackPanel>

                <!-- Search box -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="🔍 Filter: " VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#AAA"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Padding="4,2" Background="#1E1E1E" Foreground="White" BorderBrush="#555"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Process Tree / DataGrid -->
        <Grid Grid.Row="1">
            <!-- TreeView (Process Explorer hierarchy) -->
            <TreeView ItemsSource="{Binding ProcessTree}" 
                      Background="#1E1E1E" 
                      BorderThickness="0"
                      SelectedItemChanged="OnTreeViewSelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Background" Value="{Binding HighlightColor}" />
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="2,1"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#094771"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/> <!-- Name & Icon -->
                                <ColumnDefinition Width="70"/>  <!-- PID -->
                                <ColumnDefinition Width="80"/>  <!-- CPU -->
                                <ColumnDefinition Width="100"/> <!-- Private Bytes -->
                                <ColumnDefinition Width="100"/> <!-- Working Set -->
                                <ColumnDefinition Width="70"/>  <!-- Threads -->
                                <ColumnDefinition Width="80"/>  <!-- Handles -->
                                <ColumnDefinition Width="110"/> <!-- Architecture -->
                                <ColumnDefinition Width="*"/>   <!-- Description -->
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#E0E0E0"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding ProcessId}" Foreground="#AAA" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding CpuUsage, StringFormat={}{0:F1}%}" Foreground="{Binding CpuUsage, Converter={StaticResource CpuColorConverter}}" HorizontalAlignment="Right" Margin="0,0,10,0" FontWeight="Bold"/>
                            <TextBlock Grid.Column="3" Text="{Binding PrivateBytesDisplay}" Foreground="#B0BEC5" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="4" Text="{Binding WorkingSetDisplay}" Foreground="#90A4AE" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="5" Text="{Binding ThreadCount}" Foreground="#AAA" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="6" Text="{Binding HandleCount}" Foreground="#AAA" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="7" Text="{Binding Architecture}" Foreground="#81C784" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="{Binding Description}" Foreground="#888" TextTrimming="CharacterEllipsis" Margin="10,0,0,0"/>
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#3E3E42" Cursor="SizeNS"/>

        <!-- Lower Pane: Tabs for DLLs, Handles, Threads -->
        <TabControl Grid.Row="3" Background="#1E1E1E" BorderBrush="#3E3E42">
            <!-- Loaded Modules / DLLs -->
            <TabItem Header="📦 Loaded Modules (DLLs)">
                <DataGrid ItemsSource="{Binding Modules}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Module Name" Binding="{Binding Name}" Width="180"/>
                        <DataGridTextColumn Header="Base Address" Binding="{Binding BaseAddress}" Width="120"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="90"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="220"/>
                        <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="150"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Handles -->
            <TabItem Header="🔑 Open Handles">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#252526" Padding="5">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Close Handle" Click="OnCloseHandle_Click" Padding="8,2" Background="#D32F2F" Foreground="White" BorderThickness="0"/>
                            <TextBlock Text="  (Caution: Closing system handles can cause process instability)" Foreground="#888"/>
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="1" x:Name="HandlesGrid" ItemsSource="{Binding Handles}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Handle" Binding="{Binding HandleValue}" Width="90"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="130"/>
                            <DataGridTextColumn Header="Object Name" Binding="{Binding Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Threads -->
            <TabItem Header="🧵 Threads">
                <DataGrid ItemsSource="{Binding Threads}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Thread ID" Binding="{Binding ThreadId}" Width="100"/>
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="120"/>
                        <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="90"/>
                        <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime}" Width="140"/>
                        <DataGridTextColumn Header="CPU Time" Binding="{Binding CpuTime}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Process Environment & Info -->
            <TabItem Header="ℹ Process Properties">
                <ScrollViewer Background="#252526" Padding="15">
                    <StackPanel DataContext="{Binding SelectedProcess}">
                        <TextBlock Text="Process Information" FontSize="16" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Executable Path:" FontWeight="SemiBold"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ExecutablePath, Mode=OneWay}" IsReadOnly="True" Background="Transparent" Foreground="#DDD" BorderThickness="0"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Command Line:" FontWeight="SemiBold"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CommandLine, Mode=OneWay}" IsReadOnly="True" Background="Transparent" Foreground="#DDD" BorderThickness="0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Company:" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CompanyName}" Foreground="#DDD"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Architecture:" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Architecture}" Foreground="#DDD"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Start Time:" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding StartTime}" Foreground="#DDD"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Base Priority:" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Priority}" Foreground="#DDD"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="4" Background="#007ACC" Foreground="White" Padding="6,3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CPU: " Foreground="#DDD"/>
                    <TextBlock Text="{Binding TotalCpuUsage, StringFormat={}{0:F1}%}" FontWeight="Bold" Margin="0,0,15,0"/>
                    <TextBlock Text="Processes: " Foreground="#DDD"/>
                    <TextBlock Text="{Binding TotalProcesses}" FontWeight="Bold" Margin="0,0,15,0"/>
                    <TextBlock Text="Threads: " Foreground="#DDD"/>
                    <TextBlock Text="{Binding TotalThreads}" FontWeight="Bold" Margin="0,0,15,0"/>
                    <TextBlock Text="Handles: " Foreground="#DDD"/>
                    <TextBlock Text="{Binding TotalHandles}" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
